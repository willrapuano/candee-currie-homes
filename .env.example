# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Sanity CMS ---
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id        # Sanity project id (public)
NEXT_PUBLIC_SANITY_DATASET=production                # Sanity dataset name (public)
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01            # Sanity API version (public)
SANITY_API_TOKEN=                                    # Write-capable Sanity token; used only by content scripts (server-side)

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://example.com             # Canonical site URL for metadata/sitemap
NEXT_PUBLIC_SITE_NAME=                               # Display name of the site

# --- IDX (Repliers) ---
REPLIERS_API_KEY=                                    # Repliers IDX API key (server-side)
NEXT_PUBLIC_REPLIERS_MLS_BOARD=                      # MLS board id for Repliers

# --- GoHighLevel CRM ---
GHL_API_KEY=                                         # GHL Private Integration Token (pit-...); used by /api/contact and /api/home-value fallback path
GHL_LOCATION_ID=                                     # GHL sub-account location id; required when no webhook URL is set
GHL_WEBHOOK_URL=                                     # Inbound GHL webhook for contact form leads (preferred over API path)
GHL_HOME_VALUE_WEBHOOK_URL=                          # Inbound GHL webhook for home-value leads (falls back to GHL_WEBHOOK_URL)

# --- Home valuation (LLM assist) ---
OPENAI_API_KEY=                                      # OpenAI key used by lib/home-valuation.ts
HOME_VALUE_LLM_MODEL=gpt-4o-mini                     # Model name for the valuation helper

# --- Analytics ---
NEXT_PUBLIC_GA4_ID=                                  # Google Analytics 4 measurement id
NEXT_PUBLIC_GTM_ID=                                  # Google Tag Manager container id

# --- Email (contact form) ---
CONTACT_EMAIL_TO=                                    # Recipient for contact-form notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
